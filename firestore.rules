// Project collections: name (1..60 characters), updatedAt (server timestamp); ownership comes from the uid path.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validCollection() {
      return request.resource.data.keys().hasAll(['name','updatedAt'])
        && request.resource.data.keys().hasOnly(['name','parent','updatedAt'])
        && (!('parent' in request.resource.data) || (request.resource.data.parent is string && request.resource.data.parent.size() > 0 && request.resource.data.parent.size() <= 60))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/collections/{collectionId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && validCollection();
    }
    match /users/{uid}/projects/{projectId} {
      match /versions/{slot} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && slot.matches("[0-9]")
          && request.resource.data.keys().hasOnly(["name","graph","updatedAt"])
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.graph is string && request.resource.data.graph.size() < 700000
          && request.resource.data.updatedAt == request.time;
      }
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'graph', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.graph is string
        && request.resource.data.graph.size() < 700000
        && request.resource.data.updatedAt == request.time;
    }
  }
}
